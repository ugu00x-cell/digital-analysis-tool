# AI News Monitor - 環境変数テンプレート
#
# 本ファイルをコピーして .env を作成し、実際の値を入力してください。
# .env は .gitignore に追加済み（リポジトリに含めない）
#

# ============================================================================
# X API v2 認証設定
# ============================================================================
# 以下のいずれかを設定する：
#   1. Bearer Token（推奨）
#   2. API Key + API Secret + Access Token + Access Token Secret

# Bearer Token（OAuth 2.0）
# https://developer.twitter.com/en/docs/authentication/oauth-2-0/bearer-tokens
X_BEARER_TOKEN=your_bearer_token_here

# または、API Keys（Classic auth）
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# ============================================================================
# Slack 設定
# ============================================================================
# Slack Webhook URL
# https://api.slack.com/messaging/webhooks
# Format: https://hooks.slack.com/services/YOUR_TEAM_ID/YOUR_CHANNEL_ID/YOUR_TOKEN
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL_HERE

# ============================================================================
# Database 設定
# ============================================================================
DB_PATH=./data/ai_news.db

# ============================================================================
# アプリケーション設定
# ============================================================================
LOG_LEVEL=INFO
ENVIRONMENT=development

# ============================================================================
# スケジューリング設定（APScheduler）
# ============================================================================
# 朝の実行時刻
SCHEDULER_MORNING_HOUR=8
SCHEDULER_MORNING_MINUTE=0

# 夜の実行時刻
SCHEDULER_EVENING_HOUR=20
SCHEDULER_EVENING_MINUTE=0

# ============================================================================
# API レート制限・タイムアウト
# ============================================================================
# X API リクエスト間の遅延（秒）
X_REQUEST_DELAY_SEC=1.0

# Slack Webhook タイムアウト（秒）
SLACK_TIMEOUT_SEC=5
